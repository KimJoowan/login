<%@ page pageEncoding="UTF-8"%>
<%@ taglib prefix="sec" uri="http://www.springframework.org/security/tags"%>
<a class="skip-link" href="#main">본문 바로가기</a>
<header class="board-header">
	<div class="shell header-inner">
		<a class="brand" href="<c:url value='/'/>"><span class="brand-mark" aria-hidden="true">m<span>·</span></span>MyService<span class="brand-period">.</span></a>
		<nav aria-label="주요 메뉴">
			<a href="<c:url value='/'/>">홈</a><a class="active" href="<c:url value='/board/list'/>" aria-current="true">게시판</a>
		</nav>
		<div class="header-actions">
			<sec:authorize access="isAuthenticated()">
				<a class="text-link" href="<c:url value='/member/info'/>">내 정보</a>
				<form action="<c:url value='/member/logout'/>" method="post">
					<input type="hidden" name="${_csrf.parameterName}" value="${_csrf.token}">
					<button class="text-link" type="submit">로그아웃</button>
				</form>
			</sec:authorize>
			<sec:authorize access="!isAuthenticated()">
				<a class="text-link" href="<c:url value='/member/login'/>">로그인</a>
			</sec:authorize>
		</div>
	</div>
</header>
